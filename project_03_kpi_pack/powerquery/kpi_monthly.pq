// Generated by `python -m halden.kpi extract`. Do not edit by hand; edit powerquery.py.
// Loads kpi_monthly.csv. Synthetic data.
let
    Folder = Text.TrimEnd(Excel.CurrentWorkbook(){[Name = "DataFolder"]}[Content]{0}[Column1], {"\", "/"}),
    // Windows paths use \, Mac paths use /. Join with whichever the folder cell uses.
    Separator = if Text.Contains(Folder, "/") then "/" else "\",
    Source = Csv.Document(
        File.Contents(Folder & Separator & "kpi_monthly.csv"),
        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
    ),
    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = false]),
    Expected = {"month", "active_subscribers", "active_subscription_accounts", "new_subscribers", "churned_subscribers", "monthly_churn_rate", "new_customers", "new_accounts", "mrr_gbp", "gross_revenue_gbp", "refunds_gbp", "chargebacks_gbp", "net_revenue_gbp", "paid_orders", "parcels_delivered", "parcels_late", "late_delivery_rate"},
    Checked =
        if Table.ColumnNames(Promoted) = Expected then Promoted
        else error Error.Record(
            "Unexpected columns in kpi_monthly.csv",
            "Expected: " & Text.Combine(Expected, ", "),
            "Found: " & Text.Combine(Table.ColumnNames(Promoted), ", ")
        ),
    Typed = Table.TransformColumnTypes(Checked, {
        {"month", type text},
        {"active_subscribers", Int64.Type},
        {"active_subscription_accounts", Int64.Type},
        {"new_subscribers", Int64.Type},
        {"churned_subscribers", Int64.Type},
        {"monthly_churn_rate", type number},
        {"new_customers", Int64.Type},
        {"new_accounts", Int64.Type},
        {"mrr_gbp", type number},
        {"gross_revenue_gbp", type number},
        {"refunds_gbp", type number},
        {"chargebacks_gbp", type number},
        {"net_revenue_gbp", type number},
        {"paid_orders", Int64.Type},
        {"parcels_delivered", Int64.Type},
        {"parcels_late", Int64.Type},
        {"late_delivery_rate", type number}
    }, "en-US"),
    Sorted = Table.Sort(Typed, {{"month", Order.Ascending}})
in
    Sorted
