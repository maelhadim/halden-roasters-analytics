// Generated by `python -m halden.kpi extract`. Do not edit by hand; edit powerquery.py.
// Loads revenue_bridge_monthly.csv. Synthetic data.
let
    Folder = Text.TrimEnd(Excel.CurrentWorkbook(){[Name = "DataFolder"]}[Content]{0}[Column1], {"\", "/"}),
    // Windows paths use \, Mac paths use /. Join with whichever the folder cell uses.
    Separator = if Text.Contains(Folder, "/") then "/" else "\",
    Source = Csv.Document(
        File.Contents(Folder & Separator & "revenue_bridge_monthly.csv"),
        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
    ),
    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = false]),
    Expected = {"month", "bi_reported_gbp", "step1_duplicate_loads", "step2_test_orders", "step3_unpaid_orders", "step4_capture_month", "step5_daily_fx", "step6_refunds_chargebacks", "step7_vat", "net_revenue_gbp", "residual_gbp"},
    Checked =
        if Table.ColumnNames(Promoted) = Expected then Promoted
        else error Error.Record(
            "Unexpected columns in revenue_bridge_monthly.csv",
            "Expected: " & Text.Combine(Expected, ", "),
            "Found: " & Text.Combine(Table.ColumnNames(Promoted), ", ")
        ),
    Typed = Table.TransformColumnTypes(Checked, {
        {"month", type text},
        {"bi_reported_gbp", type number},
        {"step1_duplicate_loads", type number},
        {"step2_test_orders", type number},
        {"step3_unpaid_orders", type number},
        {"step4_capture_month", type number},
        {"step5_daily_fx", type number},
        {"step6_refunds_chargebacks", type number},
        {"step7_vat", type number},
        {"net_revenue_gbp", type number},
        {"residual_gbp", type number}
    }, "en-US"),
    Sorted = Table.Sort(Typed, {{"month", Order.Ascending}})
in
    Sorted
