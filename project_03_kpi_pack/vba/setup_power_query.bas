Attribute VB_Name = "SetupPowerQuery"
' Turns the snapshot KPI pack into one that refreshes from the CSV files.
'
' Run once, in Windows Excel 365, on halden_kpi_pack.xlsx:
'   1. Alt+F11, File > Import File, choose this file.
'   2. Alt+F8, run SetupQueries.
'   3. Save as .xlsx. Excel warns that the macro will be removed: choose Yes. The queries stay.
'
' What it does, for each Data_ sheet:
'   - reads the matching .pq file from the powerquery folder next to the workbook;
'   - adds the query, or replaces it if it is already there, so running it twice is safe;
'   - deletes the snapshot table and loads the query's table at A1 in its place.
' Every formula in the pack finds its columns by header name, so it does not matter that the
' snapshot is deleted and a new table appears.
Option Explicit

Private Function QueryNames() As Variant
    QueryNames = Array("kpi_monthly", "kpi_country_monthly", "revenue_bridge_monthly", "kpi_manifest")
End Function

Private Function SheetNames() As Variant
    SheetNames = Array("Data_Monthly", "Data_Country", "Data_Bridge", "Data_Manifest")
End Function

' The .pq files are UTF-8. VBA's own Open/Input reads the Windows code page, so read them with
' ADODB.Stream instead.
Private Function ReadUtf8(ByVal path As String) As String
    Dim s As Object
    Set s = CreateObject("ADODB.Stream")
    s.Type = 2
    s.Charset = "utf-8"
    s.Open
    s.LoadFromFile path
    ReadUtf8 = s.ReadText
    s.Close
End Function

Private Sub UseLocalDataFolderIfNeeded(ByVal wb As Workbook)
    ' The pack ships with an example path. If it does not exist on this PC, point it at the
    ' data folder next to the workbook, which is where the repository keeps it.
    Dim cell As Range
    Set cell = wb.Names("DataFolder").RefersToRange
    If Dir(cell.Value & "\kpi_monthly.csv") = "" Then
        If Dir(wb.Path & "\data\kpi_monthly.csv") = "" Then
            Err.Raise vbObjectError + 1, , "Cannot find kpi_monthly.csv in " & cell.Value & _
                " or in " & wb.Path & "\data. Put the folder path in Settings!C4 and run this again."
        End If
        cell.Value = wb.Path & "\data"
    End If
End Sub

Private Sub LoadQuery(ByVal wb As Workbook, ByVal queryName As String, ByVal sheetName As String)
    Dim pqPath As String, ws As Worksheet, lo As ListObject, q As WorkbookQuery, c As WorkbookConnection

    pqPath = wb.Path & "\powerquery\" & queryName & ".pq"
    If Dir(pqPath) = "" Then Err.Raise vbObjectError + 2, , "Missing " & pqPath

    For Each q In wb.Queries
        If q.Name = queryName Then q.Delete: Exit For
    Next q
    For Each c In wb.Connections
        If c.Name = "Query - " & queryName Then c.Delete: Exit For
    Next c
    wb.Queries.Add Name:=queryName, Formula:=ReadUtf8(pqPath), Description:="Generated by halden.kpi; see powerquery.py"

    Set ws = wb.Worksheets(sheetName)
    Do While ws.ListObjects.Count > 0
        ws.ListObjects(1).Delete
    Loop
    ws.Cells.Clear

    Set lo = ws.ListObjects.Add(SourceType:=0, Source:= _
        "OLEDB;Provider=Microsoft.Mashup.OleDb.1;Data Source=$Workbook$;Location=" & queryName & _
        ";Extended Properties=""""", Destination:=ws.Range("A1"))
    lo.Name = "q_" & queryName
    With lo.QueryTable
        .CommandType = xlCmdSql
        .CommandText = Array("SELECT * FROM [" & queryName & "]")
        .RefreshOnFileOpen = False
        .BackgroundQuery = False
        .PreserveColumnInfo = True
        .AdjustColumnWidth = True
        .Refresh BackgroundQuery:=False
    End With
End Sub

Public Sub SetupQueries()
    Dim wb As Workbook, i As Long, queryList As Variant, sheetList As Variant
    Set wb = ActiveWorkbook
    If wb.Path = "" Then
        MsgBox "Save the workbook in the project_03_kpi_pack folder first.", vbExclamation
        Exit Sub
    End If
    On Error GoTo Failed
    Application.ScreenUpdating = False
    UseLocalDataFolderIfNeeded wb
    queryList = QueryNames()
    sheetList = SheetNames()
    For i = LBound(queryList) To UBound(queryList)
        Application.StatusBar = "Loading " & queryList(i) & "..."
        LoadQuery wb, queryList(i), sheetList(i)
    Next i
    Application.Calculate
    Application.StatusBar = False
    Application.ScreenUpdating = True
    MsgBox "Queries loaded. Summary says: " & wb.Worksheets("Summary").Range("C6").Value, vbInformation
    Exit Sub
Failed:
    Application.StatusBar = False
    Application.ScreenUpdating = True
    MsgBox "Setup stopped: " & Err.Description, vbCritical
End Sub
